title: $:/plugins/byper/code-copy-button/styles
tags: $:/tags/Stylesheet

/* 代码块 */
.tc-code-wrapper {
  position: relative;
  margin: 1em 0;

  & > pre {
    margin: 0;
    padding-right: 45px; /* 为按钮留出空间 */
  }

  /* 复制按钮样式 */
  & > .tc-copy-button {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 6px;
    background: rgba(100, 100, 100, 0.8);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.6;
    transition:
      opacity 0.2s,
      background 0.2s;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;

    &:hover {
      opacity: 1;
      background: rgba(80, 80, 80, 0.9);
    }

    &.tc-copied {
      background: rgba(40, 167, 69, 0.9);
    }

    & > svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }
  }
}

/* 行内代码 */
.tc-inline-code-wrapper {
  display: inline-block;
  position: relative;

  & > code {
    position: relative;
    display: inline;
  }

  & > code.tc-has-copy-button:hover + .tc-inline-copy-button,
  .tc-inline-copy-button:hover {
    opacity: 0.8;
  }

  & > .tc-inline-copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 2px;
    padding: 2px;
    background: rgba(100, 100, 100, 0.7);
    color: white;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
    vertical-align: middle;
    width: 20px;
    height: 20px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    &:hover {
      opacity: 1;
      background: rgba(80, 80, 80, 0.9);
    }

    &.tc-copied {
      background: rgba(40, 167, 69, 0.9);
    }

    & > svg {
      width: 12px;
      height: 12px;
      fill: currentColor;
    }
  }
}
