title: $:/plugins/byper/image-preview/styles
tags: $:/tags/Stylesheet

/* Image preview plugin - Modern UI styles */

.tc-image-processed {
  cursor: zoom-in;
  transition: all 0.2s ease;
  border-radius: 4px;
  
  &:hover {
    opacity: 0.85;
    transform: scale(1.02);
  }
}

.tc-image-preview-active {
  overflow: hidden;
}

img.tc-image-processed {
  max-width: 100%;
  height: auto;
}

.tc-image-preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.9) 0%, rgba(20, 20, 30, 0.95) 100%);
  backdrop-filter: blur(10px);
  z-index: 999999;
  display: none;
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: default;
  
  &.active {
    display: flex;
    opacity: 1;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.tc-image-preview-content {
  position: relative;
  max-width: 80vw;
  max-height: 80vh;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.tc-image-preview-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  cursor: grab;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: center center;
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  user-select: none;
  
  &:active {
    cursor: grabbing;
  }
}

/* Shared button styles with glassmorphism */
.tc-image-preview-btn,
.tc-image-preview-nav-btn,
.tc-image-preview-close {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  z-index: 1000000;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  
  &:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }
  
  &:active {
    background: rgba(255, 255, 255, 0.35);
    transform: scale(1.05);
  }
}

.tc-image-preview-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 44px;
  height: 44px;
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

.tc-image-preview-controls {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 1000000;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  padding: 12px 16px;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.tc-image-preview-btn {
  width: 44px;
  height: 44px;
  font-size: 20px;
  font-weight: 300;
}

.tc-image-preview-zoom-text {
  position: absolute;
  bottom: 24px;
  right: 24px;
  color: white;
  font-size: 13px;
  font-weight: 500;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  padding: 8px 14px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  z-index: 1000000;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  letter-spacing: 0.5px;
}

.tc-image-preview-navigation {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 24px;
  z-index: 1000000;
  pointer-events: none;
  
  & > * {
    pointer-events: auto;
  }
}

.tc-image-preview-nav-btn {
  width: 52px;
  height: 52px;
  font-size: 26px;
  font-weight: 300;
  
  &.hidden {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.8);
  }
}