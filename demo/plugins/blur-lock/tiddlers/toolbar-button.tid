title: $:/plugins/byper/blur-lock/ui/Buttons/Unlock
tags: $:/tags/ViewToolbar
caption: Blur Lock
description: Lock/Unlock this tiddler

\whitespace trim
<$list filter="[all[current]tag[lock]]" variable="ignore">
    <!-- Case A: Locked -> Show Unlock Popup -->
    <$list filter="[all[current]tag[lock]] :filter[{$:/state/byper/blur-lock/unlocked}!match[yes]]" variable="ignore">
        <span class="tc-popup-keep">
            <$button popup=<<qualify "$:/state/byper/blur-lock/dropdown">> class=<<tv-config-toolbar-class>> tooltip="Unlock this tiddler">
                {{$:/core/images/locked-padlock}}
                <$list filter="[<tv-config-toolbar-text>match[yes]]"><span class="tc-btn-text">Unlock</span></$list>
            </$button>
        </span>
        <$reveal state=<<qualify "$:/state/byper/blur-lock/dropdown">> type="popup" position="belowleft" animate="yes" class="tc-drop-down tc-blur-lock-dropdown tc-popup-keep">
            <h3>🔐 Content Locked</h3>
            <$list filter="[{$:/config/byper/blur-lock/password-hash}match[]]" variable="ignore">
                <div style="font-size: 0.85em; color: <<colour alert-foreground>>; margin-bottom: 10px;">
                    Password not set. Please go to sidebar settings.
                </div>
            </$list>
            <$list filter="[{$:/config/byper/blur-lock/password-hash}!match[]]" variable="ignore">
                <$edit-text tiddler="$:/temp/byper/blur-lock/password" type="password" tag="input" placeholder="Enter password..." focus="yes" />
                <$button class="tc-blur-lock-btn-primary">
                    Unlock Now
                    <$action-sendmessage $message="tm-blurlock-validate-unlock" password={{$:/temp/byper/blur-lock/password}} />
                </$button>
            </$list>
        </$reveal>
    </$list>

    <!-- Case B: Unlocked -> One-click Re-lock -->
    <$list filter="[all[current]tag[lock]] :filter[{$:/state/byper/blur-lock/unlocked}match[yes]]" variable="ignore">
        <$button class=<<tv-config-toolbar-class>> tooltip="Re-lock this tiddler">
            <$action-setfield $tiddler="$:/state/byper/blur-lock/unlocked" text="no"/>
            {{$:/core/images/unlocked-padlock}}
            <$list filter="[<tv-config-toolbar-text>match[yes]]"><span class="tc-btn-text">Lock</span></$list>
        </$button>
    </$list>
</$list>
